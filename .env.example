# Groq (free tier; sign up at https://console.groq.com - no card required)
GROQ_API_KEY=

# Optional overrides
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_CHAT_MODEL=llama-3.3-70b-versatile      # alternative: llama-3.1-8b-instant (faster, cheaper quota)
# GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo  # alternative: whisper-large-v3 (slightly slower)

# SMTP (optional until you send email)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
