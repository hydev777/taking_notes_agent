# OpenAI (required for transcription; also default for chat unless DEEPSEEK_API_KEY is set)
OPENAI_API_KEY=

# Transcription model override. Default: gpt-4o-mini-transcribe (~50% cheaper than whisper-1).
# Roll back by setting OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_TRANSCRIBE_MODEL=

# Optional: route chat (JSON extraction + paragraph synthesis) to DeepSeek for ~5-10x cheaper text inference.
# Leave DEEPSEEK_API_KEY empty to stay on OpenAI.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash

# OpenAI chat overrides (used only when DEEPSEEK_API_KEY is empty). Default: gpt-4o-mini for both.
OPENAI_CHAT_MODEL=
OPENAI_TEMPLATE_PARAGRAPH_MODEL=

# SMTP (optional until you send email)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
